# AI Sarthi / GovHealth-SLM Backend Configuration
# Copy this file to .env. No secrets are needed; never put access tokens in the frontend.

PROJECT_PATH=C:/GovHealth-SLM
# MASTER_PATH=C:/GovHealth-SLM/data/processed/healthcare_master_final_v3.csv

# Qwen3-1.7B QLoRA Adapter Settings
MODEL_ENABLED=0
# Legacy alias: LOAD_MODEL=0
BASE_MODEL_ID=Qwen/Qwen3-1.7B
# Legacy alias: BASE_MODEL=Qwen/Qwen3-1.7B
ADAPTER_PATH=C:/GovHealth-SLM/models/GovHealth-SLM-Qwen3-1.7B-QLoRA-Final
MODEL_DEVICE=auto
MODEL_MAX_NEW_TOKENS=250
# Legacy alias: MAX_NEW_TOKENS=250
MODEL_TEMPERATURE=0.1
STRICT_MODEL_REQUIRED=0

# OpenRouter AI Inference Provider
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_ENABLED=1
# OPENROUTER_TIMEOUT_SECONDS=30
# OPENROUTER_MAX_RETRIES=2
# PRIMARY_PROVIDER=openrouter

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
